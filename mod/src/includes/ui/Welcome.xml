<!-- Welcome/Help/Changelog Dialog -->

<Panel
  active="false"
  allowDragging="true"
  color="#40404080"
  height="300"
  id="welcomeDialog"
  outline="#202020"
  rectAlignment="CenterCenter"
  returnToOriginalPositionWhenReleased="false"
  width="500"
>
  <Panel 
    color="#202020"
    height="30"
    padding="5"
    rectAlignment="UpperCenter"
    width="500"
  >
    <Text color="#ffffff">Star Wars Legion for TTS</Text>
  </Panel>
  <Panel
    height="30"
    width="30"
    rectAlignment="UpperRight"
    padding="2"
  >
    <Button onClick="toggleWelcomeDialog">X</Button>
  </Panel>
  <Panel
    height="240"
    padding="5"
    width="500"
  >
    <VerticalScrollView id="welcomeTab1" active="true" color="40404080">
      <VerticalLayout padding="5">
        <Text alignment="UpperLeft" color="#ffffff" fontSize="12">
          <!--Welcome to Star Wars: Legion for TTS, <b>v8.0.0</b>.-->
          Welcome to Star Wars: Legion for TTS, <b>v8.0.21-beta</b>.

          This is a <b>beta release</b> <textcolor color="#f03333"><b></b></textcolor>.

          To access the stable version of the mod visit <i>https://go.swlegion.dev/mod</i>.

          <b>CHANGELOG</b>
          (Since last <i>Beta</i>)
          <!--(Since last <i>Stable</i>)-->
          - Add: Admiral Trench
          - Add: Super Rocket Battle Droids
          - Add: For the Cause
        </Text>
      </VerticalLayout>
    </VerticalScrollView>
    <VerticalLayout id="welcomeTab3" active="false" padding="5 5 5 5" spacing="5" childForceExpandHeight="false">
      <Text alignment="UpperLeft" color="#ffffff" fontSize="12" preferredHeight="60">Add your own cards - units, upgrades and command cards - from a file in the mod's cards.json format. Paste its URL below, press Load, then Create Army on your LIST BUILDER panel. They are lost when the mod reloads, and the file must host its own images and models.</Text>
      <InputField
        minHeight="40"
        preferredHeight="40"
        placeholder="URL of a cards.json file"
        onValueChanged="sideLoadUrlChanged"></InputField>
      <Button minHeight="40" preferredHeight="40" onClick="experimentalSideLoad">Load</Button>
      <Text alignment="UpperLeft" color="#ffffff" fontSize="12" preferredHeight="16">How to make one - select and copy this link:</Text>
      <InputField
        minHeight="40"
        preferredHeight="40">https://github.com/swlegion/tts/blob/main/contrib/cards/README.md</InputField>
    </VerticalLayout>
  </Panel>
  <Panel 
    color="#202020"
    height="30"
    offsetXY="0 -270"
    padding="5"
    rectAlignment="UpperCenter"
    width="500"
  >
    <HorizontalLayout height="30">
      <Button onClick="showWelcomeTab1">
        <Text fontSize="10" fontStyle="bold">What's New</Text>
      </Button>
      <Button onClick="showWelcomeTab3">
        <Text fontSize="10">Custom Cards Load (beta)</Text>
      </Button>
      <Button interactable="false">
        <Text fontSize="10">-</Text>
      </Button>
    </HorizontalLayout>
  </Panel>
</Panel>
